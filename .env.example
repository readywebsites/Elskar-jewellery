# ==============================================================================
# AZURE JEWELS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for your deployment environment
# ==============================================================================

# Django Secret Key (generate a secure random 50+ character string for production)
SECRET_KEY=your-secure-production-secret-key-here-min-50-characters

# Debug mode: True for development, False for production
DEBUG=True

# Allowed Hosts (comma-separated domain names or IP addresses)
ALLOWED_HOSTS=localhost,127.0.0.1,azurejewels.com,www.azurejewels.com

# Time Zone
TIME_ZONE=Asia/Kolkata
